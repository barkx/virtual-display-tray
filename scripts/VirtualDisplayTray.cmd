# ---------------------------------------------------------------------------
# Driver package cleanup from the driver store (best-effort, non-fatal)
# ---------------------------------------------------------------------------
function Remove-DriverPackage {
    try {
        $enum = & pnputil.exe /enum-drivers 2>&1
        $pending = $null
        $publishedName = $null
        foreach ($line in $enum) {
            if ($line -match '^Published Name\s*:\s*(oem\d+\.inf)') { $pending = $Matches[1] }
            elseif ($line -match '^Original Name\s*:\s*(.+)$') {
                if ($Matches[1].Trim().ToLower() -eq 'iddsampledriver.inf' -and $pending) { $publishedName = $pending }
            }
        }
        if ($publishedName) {
            Write-Log "Removing driver package $publishedName from driver store..."
            & pnputil.exe /delete-driver $publishedName /uninstall /force 2>&1 | ForEach-Object { Write-Log "pnputil: $_" }
        } else {
            Write-Log 'No matching driver package found in driver store to clean up (this is fine).'
        }
    } catch {
        Write-Log "Driver package cleanup skipped: $_"
    }
}

# ---------------------------------------------------------------------------
# High-level actions
# ---------------------------------------------------------------------------
function Enable-VirtualDisplay {
    try {
        $existing = [IddDeviceInstaller]::CountDevices()
        if ($existing -gt 0) {
            Write-Log "Enable requested but $existing device(s) already present - skipping duplicate create."
            $notifyIcon.ShowBalloonTip(4000, 'Virtual Display Driver', 'Virtual display is already enabled.', 'Info')
            return $true
        }
        Write-Log "Installing device with INF: $InfPath"
        $result = [IddDeviceInstaller]::InstallDevice($InfPath)
        Write-Log "Install result: $result"
        if ($result -eq 'installed-reboot-required') {
            $notifyIcon.ShowBalloonTip(4000, 'Virtual Display Driver', 'Installed. A reboot may be required for it to appear.', 'Info')
        } else {
            $notifyIcon.ShowBalloonTip(4000, 'Virtual Display Driver', 'Virtual display enabled.', 'Info')
        }
        return $true
    } catch {
        Write-Log "ENABLE FAILED: $_"
        $notifyIcon.ShowBalloonTip(6000, 'Virtual Display Driver', "Failed to enable: $($_.Exception.Message)", 'Error')
        [System.Windows.Forms.MessageBox]::Show("Could not install the virtual display driver.`n`n$($_.Exception.Message)`n`nSee the log for details:`n$LogPath", 'Virtual Display Tray', 'OK', 'Error') | Out-Null
        return $false
    }
}

function Disable-VirtualDisplay {
    try {
        Write-Log 'Removing device...'
        $removed = [IddDeviceInstaller]::RemoveDevice()
        Write-Log "Remove result: $removed"
        Remove-DriverPackage
        $notifyIcon.ShowBalloonTip(4000, 'Virtual Display Driver', 'Virtual display disabled.', 'Info')
        return $true
    } catch {
        Write-Log "DISABLE FAILED: $_"
        $notifyIcon.ShowBalloonTip(6000, 'Virtual Display Driver', "Failed to disable: $($_.Exception.Message)", 'Error')
        [System.Windows.Forms.MessageBox]::Show("Could not remove the virtual display driver.`n`n$($_.Exception.Message)`n`nSee the log for details:`n$LogPath", 'Virtual Display Tray', 'OK', 'Error') | Out-Null
        return $false
    }
}

function Uninstall-App {
    $confirm = [System.Windows.Forms.MessageBox]::Show(
        "This will turn off the virtual display, remove the driver, and delete Virtual Display Tray completely (including its auto-start entry).`n`nContinue?",
        'Uninstall Virtual Display Tray', 'YesNo', 'Warning')
    if ($confirm -ne 'Yes') { return }

    Write-Log 'Uninstalling app completely...'
    try {
        if ([IddDeviceInstaller]::IsDeviceInstalled()) {
            [IddDeviceInstaller]::RemoveDevice() | Out-Null
        }
        Remove-DriverPackage
    } catch { Write-Log "Uninstall device removal warning: $_" }

    try { Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue } catch {}

    $notifyIcon.Visible = $false
    $notifyIcon.Dispose()

    try {
        $cleanupCmd = "Start-Sleep -Seconds 1; Remove-Item -LiteralPath '$InstallDir' -Recurse -Force -ErrorAction SilentlyContinue"
        Start-Process -FilePath 'powershell.exe' -ArgumentList "-NoProfile -WindowStyle Hidden -Command `"$cleanupCmd`"" -WindowStyle Hidden
    } catch {}

    [System.Windows.Forms.Application]::Exit()
}

# ---------------------------------------------------------------------------
# Tray icon (drawn at runtime, no external .ico files needed)
# ---------------------------------------------------------------------------
function New-DotIcon([System.Drawing.Color]$color) {
    $bmp = New-Object System.Drawing.Bitmap 32, 32
    $g = [System.Drawing.Graphics]::FromImage($bmp)
    $g.SmoothingMode = 'AntiAlias'
    $g.Clear([System.Drawing.Color]::Transparent)
    $g.FillEllipse((New-Object System.Drawing.SolidBrush($color)), 2, 2, 28, 28)
    $g.DrawEllipse((New-Object System.Drawing.Pen([System.Drawing.Color]::Black, 1)), 2, 2, 28, 28)
    $g.Dispose()
    $hicon = $bmp.GetHicon()
    return [System.Drawing.Icon]::FromHandle($hicon)
}

$IconOn   = New-DotIcon([System.Drawing.Color]::LimeGreen)
$IconOff  = New-DotIcon([System.Drawing.Color]::Firebrick)
$IconBusy = New-DotIcon([System.Drawing.Color]::Goldenrod)

$notifyIcon = New-Object System.Windows.Forms.NotifyIcon
$notifyIcon.Visible = $true

$menu = New-Object System.Windows.Forms.ContextMenuStrip
$toggleItem  = $menu.Items.Add('')
$openLogItem = $menu.Items.Add('Open log file')
$menu.Items.Add('-') | Out-Null
$uninstallItem = $menu.Items.Add('Uninstall completely')
$menu.Items.Add('-') | Out-Null
$exitItem    = $menu.Items.Add('Exit (keep installed)')
$notifyIcon.ContextMenuStrip = $menu

$script:State = 'unknown'

function Update-TrayState {
    $count = 0
    try { $count = [IddDeviceInstaller]::CountDevices() } catch { Write-Log "State check failed: $_" }
    if ($count -gt 1) {
        $script:State = 'duplicate'
        $notifyIcon.Icon = $IconBusy
        $notifyIcon.Text = "Virtual Display: $count copies found`n(click to fix)"
        $toggleItem.Text = "Fix duplicate displays ($count found)"
        Write-Log "Duplicate devices detected: $count"
    } elseif ($count -eq 1) {
        $script:State = 'on'
        $notifyIcon.Icon = $IconOn
        $notifyIcon.Text = "Virtual Display: ON`n(click to disable)"
        $toggleItem.Text = 'Disable virtual display'
    } else {
        $script:State = 'off'
        $notifyIcon.Icon = $IconOff
        $notifyIcon.Text = "Virtual Display: OFF`n(click to enable)"
        $toggleItem.Text = 'Enable virtual display'
    }
}

function Invoke-Toggle {
    $notifyIcon.Icon = $IconBusy
    $notifyIcon.Text = 'Virtual Display: working...'
    [System.Windows.Forms.Application]::DoEvents()
    if ($script:State -eq 'on' -or $script:State -eq 'duplicate') {
        Disable-VirtualDisplay | Out-Null
        if ($script:State -eq 'duplicate') {
            $notifyIcon.ShowBalloonTip(4000, 'Virtual Display Driver', 'Removed the duplicate displays. Click again to turn the virtual display back on.', 'Info')
        }
    } else {
        Enable-VirtualDisplay | Out-Null
    }
    Update-TrayState
}

$toggleItem.Add_Click({ Invoke-Toggle })
$notifyIcon.Add_MouseClick({
    param($s, $e)
    if ($e.Button -eq [System.Windows.Forms.MouseButtons]::Left) { Invoke-Toggle }
})
$openLogItem.Add_Click({
    if (-not (Test-Path $LogPath)) { New-Item -Path $LogPath -ItemType File -Force | Out-Null }
    Start-Process -FilePath 'notepad.exe' -ArgumentList "`"$LogPath`""
})
$uninstallItem.Add_Click({ Uninstall-App })
$exitItem.Add_Click({
    $notifyIcon.Visible = $false
    $notifyIcon.Dispose()
    [System.Windows.Forms.Application]::Exit()
})

Update-TrayState
if ($isFirstRun) {
    $notifyIcon.ShowBalloonTip(5000, 'Virtual Display Tray', 'Installed. Click the tray icon anytime to turn the virtual display on or off.', 'Info')
}
Write-Log "Tray ready. Initial state: $($script:State)"

[System.Windows.Forms.Application]::Run()

$mutex.ReleaseMutex() | Out-Null
