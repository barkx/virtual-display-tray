@echo off
net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)
powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$ps=((Get-Content -LiteralPath '%~f0') | Select-Object -Skip 9) -join [Environment]::NewLine; $SelfCmdPath='%~f0'; Invoke-Expression $ps"
goto :eof
:PS1_BEGIN (not used for parsing - human marker only)
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$InstallDir = Join-Path $env:ProgramData 'VirtualDisplayTray'
$LogPath    = Join-Path $InstallDir 'VirtualDisplayTray.log'
$TaskName   = 'VirtualDisplayTray'
$HWID       = 'Root\IddSampleDriver'

function Write-Log {
    param([string]$Message)
    $line = "[{0}] {1}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
    try {
        if (-not (Test-Path $InstallDir)) { New-Item -Path $InstallDir -ItemType Directory -Force | Out-Null }
        Add-Content -Path $LogPath -Value $line -Encoding UTF8
    } catch {}
}

# ---------------------------------------------------------------------------
# Single-instance guard
# ---------------------------------------------------------------------------
$mutexCreated = $false
$mutex = New-Object System.Threading.Mutex($true, 'Global\VirtualDisplayTray_SingleInstance', [ref]$mutexCreated)
if (-not $mutexCreated) {
    [System.Windows.Forms.MessageBox]::Show('Virtual Display Tray is already running (check your system tray).', 'Virtual Display Tray', 'OK', 'Information') | Out-Null
    exit
}

Write-Log '--------------------------------------------------'
Write-Log "Starting. SelfCmdPath=$SelfCmdPath"

